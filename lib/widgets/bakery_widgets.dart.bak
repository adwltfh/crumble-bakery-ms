import 'package:material_ui/material_ui.dart';
import '../theme/bakery_theme.dart';

/// Reuse approved PNG assets instead of redrawing the frames.
/// Keep sprite sampling nearest-neighbor for a crisp pixel look.
class PixelAsset extends StatelessWidget {
  const PixelAsset(this.path, {super.key, this.width, this.height,
    this.fit = BoxFit.contain});
  final String path;
  final double? width;
  final double? height;
  final BoxFit fit;

  @override
  Widget build(BuildContext context) => Image.asset(path,
    width: width, height: height, fit: fit,
    filterQuality: FilterQuality.none,
    isAntiAlias: false,
    semanticLabel: path.split('/').last.replaceAll('_', ' '),
  );
}

/// Frame uses the provided transparent PNG art; content is real Flutter text.
class PixelFrame extends StatelessWidget {
  const PixelFrame({super.key, required this.asset, required this.child,
    this.padding = const EdgeInsets.all(12), this.background});
  final String asset;
  final Widget child;
  final EdgeInsets padding;
  final Color? background;

  @override
  Widget build(BuildContext context) => Stack(
    fit: StackFit.passthrough,
    children: [
      if (background != null) Positioned.fill(child: ColoredBox(color: background!)),
      Positioned.fill(child: Image.asset(asset, fit: BoxFit.fill,
        filterQuality: FilterQuality.none)),
      Padding(padding: padding, child: child),
    ],
  );
}

class QuantityControl extends StatelessWidget {
  const QuantityControl({super.key, required this.quantity,
    required this.onPlus, required this.onMinus, this.compact = false});
  final int quantity;
  final VoidCallback onPlus;
  final VoidCallback onMinus;
  final bool compact;

  @override
  Widget build(BuildContext context) {
    final buttonSize = compact ? 30.0 : 36.0;
    return Semantics(
      label: 'Jumlah $quantity',
      child: Row(mainAxisSize: MainAxisSize.min, children: [
        _QuantityButton(asset: 'assets/ui/quantity_minus.png',
          size: buttonSize, label: 'Kurangi', onTap: quantity == 0 ? null : onMinus,
          symbol: '−', dark: false),
        SizedBox(width: compact ? 25 : 30, child: Text('$quantity',
          textAlign: TextAlign.center, style: BakeryText.heading(compact ? 15 : 18))),
        _QuantityButton(asset: 'assets/ui/quantity_plus.png',
          size: buttonSize, label: 'Tambah', onTap: onPlus,
          symbol: '+', dark: true),
      ]),
    );
  }
}

class _QuantityButton extends StatelessWidget {
  const _QuantityButton({required this.asset, required this.size,
    required this.label, required this.onTap, required this.symbol,
    required this.dark});
  final String asset;
  final double size;
  final String label;
  final VoidCallback? onTap;
  final String symbol;
  final bool dark;

  @override
  Widget build(BuildContext context) => Semantics(
    button: true, enabled: onTap != null, label: label,
    child: Opacity(
      opacity: onTap == null ? .45 : 1,
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(4),
        child: SizedBox(width: size, height: size,
          child: Stack(alignment: Alignment.center, children: [
            Positioned.fill(child: PixelAsset(asset, fit: BoxFit.fill)),
            Text(symbol, style: TextStyle(fontSize: size * .62,
              fontWeight: FontWeight.w900, height: 1,
              color: dark ? BakeryColors.panelLight : BakeryColors.darkCocoa)),
          ])),
      ),
    ),
  );
}

class BakeryViewport extends StatelessWidget {
  const BakeryViewport({super.key, required this.child});
  final Widget child;

  @override
  Widget build(BuildContext context) => Center(
    child: ConstrainedBox(
      constraints: const BoxConstraints(maxWidth: 540),
      child: DecoratedBox(
        decoration: const BoxDecoration(
          color: BakeryColors.background,
          border: Border(left: BorderSide(color: BakeryColors.darkCocoa, width: 3),
            right: BorderSide(color: BakeryColors.darkCocoa, width: 3)),
          boxShadow: [BoxShadow(color: Color(0x1E4D261C), blurRadius: 26, offset: Offset(0, 5))],
        ),
        child: child,
      ),
    ),
  );
}

class DecoratedCheckoutButton extends StatelessWidget {
  const DecoratedCheckoutButton({super.key, required this.onPressed,
    this.label = 'Buat Pesanan'});
  final VoidCallback? onPressed;
  final String label;

  @override
  Widget build(BuildContext context) => Opacity(
    opacity: onPressed == null ? .55 : 1,
    child: Semantics(
      button: true, label: label,
      child: InkWell(
        onTap: onPressed,
        child: SizedBox(height: 72,
          child: Stack(alignment: Alignment.center, children: [
            const Positioned.fill(child: PixelAsset('assets/ui/checkout_button.png',
              fit: BoxFit.fill)),
            Row(mainAxisSize: MainAxisSize.min, children: [
              const Icon(Icons.shopping_bag_outlined, size: 22,
                color: BakeryColors.panelLight),
              const SizedBox(width: 10),
              Text(label, style: const TextStyle(color: BakeryColors.panelLight,
                fontWeight: FontWeight.w900, fontSize: 19)),
            ]),
          ]),
        ),
      ),
    ),
  );
}
