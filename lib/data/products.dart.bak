/// Menu demo mengikuti tujuh varian dan harga di foto yang diberikan pengguna.
/// Ubah daftar ini untuk menyesuaikan stok dan harga nyata.
class BakeryProduct {
  const BakeryProduct({
    required this.id,
    required this.name,
    required this.price,
    required this.asset,
  });

  final String id;
  final String name;
  final int price;
  final String asset;
}

