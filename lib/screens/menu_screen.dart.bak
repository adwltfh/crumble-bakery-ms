import 'package:material_ui/material_ui.dart';
import '../data/products.dart';
import '../state/basket_controller.dart';
import '../theme/bakery_theme.dart';
import '../widgets/bakery_widgets.dart';
import '../widgets/cute_bakery_widgets.dart';
import 'cart_screen.dart';

/// Cute bakery storefront. All product names, prices, and counts are live.
class MenuScreen extends StatelessWidget {
  const MenuScreen({super.key, required this.basket});
  final BasketController basket;

  void _openBasket(BuildContext context) {
    Navigator.of(context).push(MaterialPageRoute<void>(
      builder: (_) => CartScreen(basket: basket),
    ));
  }

  @override
  Widget build(BuildContext context) => BakeryViewport(
        child: Scaffold(
          backgroundColor: BakeryColors.background,
          body: SafeArea(
            child: AnimatedBuilder(
              animation: basket,
              builder: (context, _) => Stack(
                children: [
                  const Positioned.fill(
                    child: DecoratedBox(
                      decoration: BoxDecoration(
                        gradient: LinearGradient(
                          begin: Alignment.topCenter,
                          end: Alignment.bottomCenter,
                          colors: [Color(0xFFFFF2DC), Color(0xFFFFE5C5)],
                        ),
                      ),
                    ),
                  ),
                  CustomScrollView(
                    physics: const BouncingScrollPhysics(),
                    slivers: [
                      const SliverToBoxAdapter(
                        child: AspectRatio(
                          aspectRatio: 576 / 393,
                          child: PixelAsset(
                            'assets/hero_bakery.png',
                            fit: BoxFit.fill,
                          ),
                        ),
                      ),
                      const SliverToBoxAdapter(child: SizedBox(height: 4)),
                      SliverList.builder(
                        itemCount: products.length,
                        itemBuilder: (context, index) => ProductMenuRow(
                          key: ValueKey(products[index].id),
                          product: products[index],
                          basket: basket,
                        ),
                      ),
                      const SliverToBoxAdapter(child: SizedBox(height: 156)),
                    ],
                  ),
                  // Bakery floor and flower pots stay behind the real basket.
                  const Positioned(
                    left: 0,
                    right: 0,
                    bottom: 0,
                    child: IgnorePointer(
                      child: SizedBox(
                        height: 126,
                        child: PixelAsset(
                          'assets/menu_footer.png',
                          fit: BoxFit.fill,
                        ),
                      ),
                    ),
                  ),
                  Positioned(
                    left: 23,
                    right: 23,
                    bottom: 18,
                    child: _FloatingBasket(
                      basket: basket,
                      onTap: () => _openBasket(context),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      );
}

class ProductMenuRow extends StatelessWidget {
  const ProductMenuRow({
    super.key,
    required this.product,
    required this.basket,
  });

  final BakeryProduct product;
  final BasketController basket;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 11, vertical: 5),
      child: SizedBox(
        height: 108,
        child: CuteFrame(
          asset: 'assets/menu_card.png',
          slice: const Rect.fromLTRB(36, 36, 540, 88),
          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
          child: LayoutBuilder(
            builder: (context, constraints) {
              final compact = constraints.maxWidth < 335;
              final imageSize = compact ? 55.0 : 67.0;
              return Row(
                children: [
                  CuteProductPlate(asset: product.asset, size: imageSize),
                  const SizedBox(width: 8),
                  Container(
                    width: 1.5,
                    height: 65,
                    color: const Color(0xFFCE9B78),
                  ),
                  SizedBox(width: compact ? 7 : 10),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text(
                          product.name,
                          maxLines: 2,
                          overflow: TextOverflow.ellipsis,
                          style: BakeryText.label(
                            compact ? 13 : 16,
                            weight: FontWeight.w900,
                          ),
                        ),
                        const SizedBox(height: 5),
                        Text(
                          rupiah(product.price),
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: BakeryText.label(
                            compact ? 11 : 13,
                            weight: FontWeight.w600,
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(width: 5),
                  CuteQuantityControl(
                    quantity: basket.quantityOf(product.id),
                    compact: true,
                    onPlus: () => basket.increment(product.id),
                    onMinus: () => basket.decrement(product.id),
                  ),
                ],
              );
            },
          ),
        ),
      ),
    );
  }
}

class _FloatingBasket extends StatelessWidget {
  const _FloatingBasket({required this.basket, required this.onTap});

  final BasketController basket;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) => Semantics(
        button: true,
        label: 'Buka keranjang, ${basket.itemCount} item, '
            '${rupiah(basket.subtotal)}',
        child: InkWell(
          onTap: onTap,
          child: SizedBox(
            height: 80,
            child: CuteFrame(
              asset: 'assets/floating_bar.png',
              slice: const Rect.fromLTRB(36, 35, 478, 68),
              padding: const EdgeInsets.symmetric(horizontal: 19, vertical: 10),
              child: Row(
                children: [
                  const PixelAsset('assets/basket.png', width: 51, height: 53),
                  const SizedBox(width: 11),
                  Container(width: 1.5, height: 47, color: const Color(0xFFFFE6C9)),
                  const SizedBox(width: 13),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text(
                          '${basket.itemCount} item',
                          style: const TextStyle(
                            fontSize: 17,
                            color: Color(0xFFFFF6E7),
                            fontWeight: FontWeight.w900,
                          ),
                        ),
                        const SizedBox(height: 2),
                        Text(
                          rupiah(basket.subtotal),
                          style: const TextStyle(
                            fontSize: 15,
                            color: Color(0xFFFFF6E7),
                            fontWeight: FontWeight.w700,
                          ),
                        ),
                      ],
                    ),
                  ),
                  const PixelAsset('assets/arrow.png', width: 46, height: 46),
                ],
              ),
            ),
          ),
        ),
      );
}
